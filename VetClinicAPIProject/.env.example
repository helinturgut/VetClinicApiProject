# Copy this file to .env for local development.
# Do not commit the real .env file.
JwtSettings__Secret=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Optional JWT overrides
# JwtSettings__Issuer=VetClinicApi
# JwtSettings__Audience=VetClinicApi
# JwtSettings__ExpirationInMinutes=60

# Connection string override for containers/production
# ConnectionStrings__DefaultConnection=Data Source=/app/data/vetclinic.db

# CORS origins for frontend clients (set in CI/CD or deployment env vars)
# Cors__AllowedOrigins__0=https://app.yourdomain.com

# Email settings (Gmail)
# Use the password of the vetclinic.system.app@gmail.com account.
# Make sure 2-Step Verification IS enabled and use a Gmail App Password (not your real password).
EmailSettings__Username=vetclinic.system.app@gmail.com
EmailSettings__Password=your-gmail-password
EmailSettings__FromEmail=vetclinic.system.app@gmail.com
